<Window
    x:Class="BookRead.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="236"
    Height="152"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    ShowActivated="True"
    Topmost="True"
    WindowStartupLocation="Manual"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <Border
        Margin="6"
        Padding="8"
        Background="{DynamicResource SurfaceBackground}"
        BorderBrush="{DynamicResource Line}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Direction="270"
                Opacity="0.34"
                ShadowDepth="5"
                Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,6">
                <Border
                    Width="28"
                    Height="28"
                    Background="{DynamicResource AccentSurface}"
                    CornerRadius="8">
                    <Image
                        Width="19"
                        Height="19"
                        Source="/BookRead;component/readbook.ico"
                        Stretch="Uniform" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="BOOKREAD"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock
                        Text="正在后台运行"
                        Margin="0,2,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource Line}" Opacity="0.8" />
            <StackPanel Grid.Row="2" Margin="0,7,0,0">
                <Button
                    x:Name="OpenButton"
                    Height="38"
                    Padding="11,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource TrayMenuButton}"
                    Click="OpenButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="24"
                            Text="&#xE8A7;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Foreground="{DynamicResource Accent}" />
                        <TextBlock
                            Text="打开 BookRead"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ExitButton"
                    Height="38"
                    Padding="11,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource TrayMenuButton}"
                    Click="ExitButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="24"
                            Text="&#xE7E8;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock
                            Text="退出应用"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
