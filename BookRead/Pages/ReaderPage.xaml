<UserControl
    x:Class="BookRead.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackground}">
    <UserControl.Resources>
        <Style
            x:Key="ReaderScrollBar"
            TargetType="ScrollBar"
            BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="MaxWidth" Value="12" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track
                                x:Name="PART_Track"
                                Orientation="Vertical"
                                IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.LineUpCommand"
                                        Style="{StaticResource ScrollBarButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border
                                                        Width="4"
                                                        Margin="0,1"
                                                        HorizontalAlignment="Center"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                                                        CornerRadius="2" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.LineDownCommand"
                                        Style="{StaticResource ScrollBarButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ReaderToolbarRow" Height="64" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ReaderScroll" Padding="50,26,50,55" ScrollChanged="ScrollViewer_ScrollChanged" PreviewMouseWheel="ReaderScroll_PreviewMouseWheel">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="ReaderContentPanel" MaxWidth="720" HorizontalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ReaderContentTransform" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="ChapterTitle" Text="暂无正文" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,28" />
                <TextBlock x:Name="ReaderText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="17" FontFamily="Microsoft YaHei" Focusable="False" />
                <StackPanel x:Name="MarkdownContentPanel" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ReaderToolbar" Grid.Row="1" Margin="48,0">
            <ProgressBar x:Name="ReadingProgressBar" Height="3" VerticalAlignment="Top" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource ProgressTrack}" BorderThickness="0" />
            <Grid VerticalAlignment="Center" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Click="PreviousChapter_Click">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="&#xE76B;  " FontFamily="Segoe Fluent Icons" BaselineAlignment="Center" />
                            <Run Text="上一章" />
                        </TextBlock>
                    </Button>
                    <TextBlock x:Name="ChapterProgressText" Text="— / —" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="16,0" />
                    <Button Click="NextChapter_Click">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="下一章  " />
                            <Run Text="&#xE76C;" FontFamily="Segoe Fluent Icons" BaselineAlignment="Center" />
                        </TextBlock>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="44" Height="34" Padding="0" VerticalContentAlignment="Center" Click="DecreaseFont_Click">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="A " />
                            <Run Text="&#xE738;" FontFamily="Segoe Fluent Icons" BaselineAlignment="Center" />
                        </TextBlock>
                    </Button>
                    <Button Width="44" Height="34" Padding="0" VerticalContentAlignment="Center" Click="IncreaseFont_Click" Margin="4,0,0,0">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="A " />
                            <Run Text="&#xE710;" FontFamily="Segoe Fluent Icons" BaselineAlignment="Center" />
                        </TextBlock>
                    </Button>
                    <Button Width="44" Height="34" Padding="0" VerticalContentAlignment="Center" Margin="14,0,0,0" ToolTip="减小行间距" Click="DecreaseLineSpacing_Click">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="行 " />
                            <Run Text="&#xE738;" FontFamily="Segoe Fluent Icons" BaselineAlignment="Center" />
                        </TextBlock>
                    </Button>
                    <Button Width="44" Height="34" Padding="0" VerticalContentAlignment="Center" Margin="4,0,0,0" ToolTip="增大行间距" Click="IncreaseLineSpacing_Click">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Run Text="行 " />
                            <Run Text="&#xE710;" FontFamily="Segoe Fluent Icons" BaselineAlignment="Center" />
                        </TextBlock>
                    </Button>
                    <Button x:Name="ReaderTransparencyButton" Width="34" Height="34" Padding="0" VerticalContentAlignment="Center" Margin="14,0,0,0" ToolTip="开启透明背景" Click="ToggleReaderTransparency_Click">
                        <TextBlock x:Name="ReaderTransparencyIcon" Text="透" FontSize="13" HorizontalAlignment="Center" />
                    </Button>
                    <Button x:Name="ReadingThemeButton" Width="34" Height="34" Padding="0" VerticalContentAlignment="Center" Margin="14,0,0,0" ToolTip="切换为浅色主题" Click="ToggleReadingTheme_Click">
                        <TextBlock x:Name="ReadingThemeIcon" Text="&#xE706;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button Width="34" Height="34" Padding="0" VerticalContentAlignment="Center" Margin="8,0,0,0" ToolTip="章节" Click="ToggleChapterPanel_Click">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="ReaderStyleNotification" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="12,7" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="ReaderStyleNotificationText" Foreground="{DynamicResource TextPrimary}" />
        </Border>

        <Border x:Name="ChapterPanel" Grid.Row="0" HorizontalAlignment="Right" Width="255" 
				Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <TextBlock x:Name="ChapterPanelTitle" Text="章节" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChapterCountText" Text="暂无章节" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer x:Name="ChapterScroll" Padding="14,0" ScrollChanged="ScrollViewer_ScrollChanged">
                    <StackPanel x:Name="ChapterListPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
