<UserControl
    x:Class="BookRead.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Panel}">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,18">
                <Button Height="38" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource Accent}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ImportBook_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="导入本地 TXT" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ScrollViewer Padding="8,22">
                <StackPanel>
                    <TextBlock Text="我的书架" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="13,0,0,10" />
                    <ListBox
                        x:Name="BookList"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Tag="{Binding}"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OpenShelfBook_Click">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Title}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding FilePath}"
                                                Foreground="{DynamicResource TextMuted}"
                                                FontSize="11"
                                                Margin="0,5,0,0"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding FilePath}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Tag="{Binding}"
                                        ToolTip="打开所在文件夹"
                                        Click="OpenShelfBookLocation_Click">
                                        <TextBlock
                                            Text="&#xE8B7;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextMuted}" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Tag="{Binding}"
                                        ToolTip="从书架移除"
                                        Click="RemoveShelfBook_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#F44336" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock
                                            Text="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
