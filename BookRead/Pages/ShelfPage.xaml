<UserControl
    x:Class="BookRead.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:BookRead.Pages"
    PreviewKeyDown="ShelfPage_PreviewKeyDown"
    Background="{DynamicResource Panel}">
    <UserControl.Resources>
        <pages:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- 批量删除是破坏性主操作，用低饱和的危险底色表达分量，避免在标题栏里变成一块刺眼的实心红。 -->
        <!-- 行内勾选框沿用设置页的方形勾选视觉，去掉文字内边距后贴合紧凑的书架行。 -->
        <Style x:Key="ShelfCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border
                            x:Name="CheckBoxBox"
                            CornerRadius="5"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1.5">
                            <TextBlock
                                x:Name="CheckMark"
                                Text="&#xE73E;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{DynamicResource AppBackground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBox" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="CheckBoxBox" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxBox" Property="Background" Value="{DynamicResource ButtonHover}" />
                                <Setter TargetName="CheckBoxBox" Property="BorderBrush" Value="{DynamicResource InputBorderHover}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxBox" Property="Background" Value="#F0A05F" />
                                <Setter TargetName="CheckBoxBox" Property="BorderBrush" Value="#F0A05F" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckBoxBox" Property="Background" Value="{DynamicResource AccentSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="ShelfDangerButton"
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
            <Setter Property="Foreground" Value="#F44336" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A2C30" />
                </Trigger>
                <!-- 未选中任何书籍时收起底色：危险按钮不该在无事可做时保持存在感。 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 菜单项悬浮时轻微亮起并放大，移出后平滑恢复，增强操作反馈。 -->
        <Style x:Key="AddBookMenuItem" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform x:Name="MenuItemTransform" ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1.04"
                                    Duration="0:0:0.16" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1.04"
                                    Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1"
                                    Duration="0:0:0.18" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1"
                                    Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 使用 Hidden 预留操作区宽度，避免鼠标移入或移出时书籍信息发生横向跳动。 -->
        <Style
            x:Key="ShelfRowActionButton"
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                    Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- 多选模式下行内操作暂时收起，但仍占位，避免整行内容左右跳动。 -->
                <DataTrigger
                    Binding="{Binding IsSelectionMode, RelativeSource={RelativeSource AncestorType={x:Type pages:ShelfPage}}}"
                    Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
                <Popup
                    x:Name="AddBookPopup"
                    PlacementTarget="{Binding ElementName=AddBookButton}"
                    Placement="Bottom"
                    HorizontalOffset="-150"
                    VerticalOffset="4"
                    StaysOpen="False"
                    AllowsTransparency="True"
                    PopupAnimation="Fade">
                    <Border
                        Margin="10"
                        Padding="6"
                        Background="{DynamicResource DialogBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                ShadowDepth="5"
                                Direction="270"
                                Opacity="0.28"
                                Color="#000000" />
                        </Border.Effect>
                        <StackPanel MinWidth="178">
                            <Button
                                Style="{StaticResource AddBookMenuItem}"
                                Margin="0,0,0,3"
                                Click="ImportLocal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="导入本地书籍" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource AddBookMenuItem}"
                                Click="BrowseOpds_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="浏览 OPDS 书源" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            <Grid Margin="8,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="5,0,5,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ShelfHeaderText"
                        Text="我的书架"
                        Foreground="{DynamicResource TextMuted}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0" />
                    <Button
                        x:Name="SelectionToggleButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,6,0"
                        ToolTip="多选"
                        Click="SelectionToggle_Click">
                        <TextBlock
                            x:Name="SelectionToggleIcon"
                            Text="&#xE8FD;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="{DynamicResource ButtonForeground}" />
                    </Button>
                    <Button
                        x:Name="AddBookButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTip="添加书籍"
                        Click="ImportMenu_Click">
                        <TextBlock
                            Text="&#xE710;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="{DynamicResource Accent}" />
                    </Button>
                    <!-- 与添加按钮共用最右列：普通模式显示添加，多选模式换成破坏性主操作。 -->
                    <Button
                        x:Name="DeleteSelectedButton"
                        Grid.Column="2"
                        Style="{StaticResource ShelfDangerButton}"
                        ToolTip="移除选中的书籍"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Click="DeleteSelected_Click">
                        <TextBlock
                            Text="&#xE74D;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                </Grid>
                <ListBox
                    x:Name="BookList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="BookList_SelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 从其他页面跳转定位时在整行播放一次淡出的强调色，帮助用户迅速找到目标书籍。 -->
                                <Border
                                    x:Name="RowHighlight"
                                    Grid.ColumnSpan="5"
                                    Background="{DynamicResource Accent}"
                                    CornerRadius="6"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                                <!-- 多选模式下显示的勾选框，与列表项的选中状态双向同步。 -->
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Style="{StaticResource ShelfCheckBox}"
                                    Visibility="{Binding IsSelectionMode, RelativeSource={RelativeSource AncestorType={x:Type pages:ShelfPage}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                <Button
                                    Grid.Column="1"
                                    Tag="{Binding}"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OpenShelfBook_Click">
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Title}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding SourceLabel}"
                                            Foreground="{DynamicResource TextMuted}"
                                            FontSize="11"
                                            Margin="0,5,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding SourceLabel, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=hide}" />
                                        <TextBlock
                                            Text="{Binding FilePath}"
                                            Foreground="{DynamicResource TextMuted}"
                                            FontSize="11"
                                            Margin="0,5,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FilePath}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Tag="{Binding}"
                                    Style="{StaticResource ShelfRowActionButton}"
                                    ToolTip="重命名"
                                    Click="RenameShelfBook_Click">
                                    <TextBlock
                                        Text="&#xE70F;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{DynamicResource Accent}" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Tag="{Binding}"
                                    Style="{StaticResource ShelfRowActionButton}"
                                    ToolTip="打开所在文件夹"
                                    Click="OpenShelfBookLocation_Click">
                                    <TextBlock
                                        Text="&#xE8B7;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{DynamicResource Accent}" />
                                </Button>
                                <Button
                                    Grid.Column="4"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Tag="{Binding}"
                                    ToolTip="从书架移除"
                                    Click="RemoveShelfBook_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ShelfRowActionButton}">
                                            <Setter Property="Foreground" Value="#F44336" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#F44336" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock
                                        Text="&#xE74D;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
