<UserControl
    x:Class="BookRead.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Panel}">
    <UserControl.Resources>
        <!-- 使用 Hidden 预留操作区宽度，避免鼠标移入或移出时书籍信息发生横向跳动。 -->
        <Style
            x:Key="ShelfRowActionButton"
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                    Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,18">
                <Button Height="38" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource Accent}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ImportBook_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="导入本地书籍" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextMuted}"
                    FontSize="11"
                    Text="支持 TXT、Markdown、HTML、EPUB、DOCX 格式" />
            </StackPanel>
            <ScrollViewer Padding="8,22">
                <StackPanel>
                    <TextBlock Text="我的书架" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="13,0,0,10" />
                    <ListBox
                        x:Name="BookList"
                        Background="Transparent"
                        BorderThickness="0"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Tag="{Binding}"
                                        Padding="0"
										Margin="0,0,8,0"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OpenShelfBook_Click">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Title}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding FilePath}"
                                                Foreground="{DynamicResource TextMuted}"
                                                FontSize="11"
                                                Margin="0,5,0,0"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding FilePath}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Tag="{Binding}"
                                        Style="{StaticResource ShelfRowActionButton}"
                                        ToolTip="重命名"
                                        Click="RenameShelfBook_Click">
                                        <TextBlock
                                            Text="&#xE70F;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{DynamicResource Accent}" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Tag="{Binding}"
                                        Style="{StaticResource ShelfRowActionButton}"
                                        ToolTip="打开所在文件夹"
                                        Click="OpenShelfBookLocation_Click">
                                        <TextBlock
                                            Text="&#xE8B7;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{DynamicResource Accent}" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Width="32"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Tag="{Binding}"
                                        ToolTip="从书架移除"
                                        Click="RemoveShelfBook_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShelfRowActionButton}">
                                                <Setter Property="Foreground" Value="#F44336" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#F44336" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock
                                            Text="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
