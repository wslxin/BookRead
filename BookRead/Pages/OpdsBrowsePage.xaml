<UserControl
    x:Class="BookRead.Pages.OpdsBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BookRead.Controls"
    Background="{DynamicResource AppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SourceComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="SourceComboBox"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SourceComboBoxItem}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                                x:Name="ComboBoxRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                            <ToggleButton
                                x:Name="PART_ToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <!-- 覆盖系统默认 ToggleButton 模板，避免浅蓝色悬停高亮破坏深色主题。 -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="12,0,34,0"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsHitTestVisible="False" />
                            <TextBlock
                                Margin="0,0,13,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{DynamicResource TextMuted}"
                                Text="&#xE70D;"
                                IsHitTestVisible="False" />
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,6,0,0"
                                    Background="{DynamicResource DialogBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="18"
                                            Direction="270"
                                            Opacity="0.35"
                                            ShadowDepth="5"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="3" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxRoot" Property="Background" Value="{DynamicResource ButtonHover}" />
                                <Setter TargetName="ComboBoxRoot" Property="BorderBrush" Value="{DynamicResource Line}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBoxRoot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBoxRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 书卡片悬浮时提亮背景与边框并轻微放大，移出后平滑恢复。
             卡片底色必须由样式提供，元素上的本地值会屏蔽这里的状态触发器。 -->
        <Style
            x:Key="EntryCardButton"
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1.03"
                                    Duration="0:0:0.16" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1.03"
                                    Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1"
                                    Duration="0:0:0.18" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1"
                                    Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="SourceComboBox"
                Height="38"
                Style="{StaticResource SourceComboBox}"
                SelectionChanged="SourceComboBox_SelectionChanged" />
            <!-- 搜索框：搜索按钮内嵌在输入框右侧，避免占用工具栏横向空间。 -->
            <Grid
                Grid.Column="1"
                Height="38"
                Margin="10,0,0,0">
                <TextBox
                    x:Name="SearchTextBox"
                    Padding="10,0,42,0"
                    VerticalContentAlignment="Center"
                    KeyDown="SearchTextBox_KeyDown"
                    IsEnabled="False" />
                <Button
                    x:Name="SearchButton"
                    Width="30"
                    Height="30"
                    Margin="0,0,4,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Content="&#xE721;"
                    ToolTip="搜索"
                    IsEnabled="False"
                    Click="Search_Click" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox
                x:Name="EntryList"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- 清除全局列表项模板的隐藏内边距，避免浏览页卡片每行少排一项并造成右侧空白。 -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="170"
                                Margin="6,14"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Style="{StaticResource EntryCardButton}"
                                Click="EntryButton_Click"
                                Tag="{Binding}">
                                <Button.RenderTransform>
                                    <!-- 变换写在模板内，让每张卡片各自持有实例，避免共享样式值时一起缩放。 -->
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Button.RenderTransform>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Header="取消下载"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="CancelDownload_Click"
                                            Tag="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Margin="10,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid
                                        Grid.Row="0"
                                        Width="88"
                                        Height="124"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Grid.Resources>
                                            <!-- 封面圆角裁剪几何：区域与网格的 88x124 一致，半径与底衬的 6 一致，供真实封面与默认封面共用。 -->
                                            <RectangleGeometry x:Key="CoverClipGeometry" Rect="0,0,88,124" RadiusX="6" RadiusY="6" />
                                        </Grid.Resources>
                                        <Border CornerRadius="6">
                                            <Border.Style>
                                                <!-- 占位块跟随卡片悬浮一同提亮，避免与提亮后的卡片背景融为一体。 -->
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Line}" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                            Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource InputBorder}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- 真实封面按填充模式缩放并做圆角裁剪，避免比例差异时露出底衬、方角盖住圆角。 -->
                                        <Image
                                            Tag="CoverImage"
                                            Source="{Binding CoverImage}"
                                            Stretch="UniformToFill"
                                            Clip="{StaticResource CoverClipGeometry}" />
                                        <!-- 默认封面：条目缺少封面或封面加载失败时展示内置图片，加载成功后由真实封面接管。 -->
                                        <Image
                                            Tag="DefaultCoverImage"
                                            Source="/Assets/bookcover.png"
                                            Stretch="UniformToFill"
                                            Clip="{StaticResource CoverClipGeometry}"
                                            Visibility="{Binding ShowDefaultCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <!-- 下载进度直接覆盖在发起下载的卡片封面上，避免额外提示条，也让进度与书目一一对应。 -->
                                        <Border
                                            Background="#D9121416"
                                            CornerRadius="6"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Accent}"
                                                    Text="{Binding DownloadProgress, StringFormat={}{0}%}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="下载中" />
                                                <ProgressBar
                                                    Width="56"
                                                    Height="3"
                                                    Margin="0,10,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding DownloadProgress, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Text="{Binding Entry.Title}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        MaxHeight="36"
                                        TextTrimming="CharacterEllipsis"
										ToolTip="{Binding Entry.Title}"/>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        Text="{Binding Subtitle}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMuted}"
                                        Visibility="{Binding ShowAuthor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Entry.Summary}" />
                                    <ProgressBar
                                        x:Name="DownloadProgressBar"
                                        Grid.Row="3"
                                        Height="3"
                                        Margin="0,8,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding DownloadProgress, Mode=OneWay}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            <!-- 空状态浮层：与列表同格并后置声明，保证提示居中显示在书卡片之上；
                 IsHitTestVisible=False 避免提示拦截列表的点击与右键菜单。 -->
            <Border
                x:Name="EmptyStatePanel"
                MaxWidth="420"
                Margin="24"
                Padding="32,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <StackPanel>
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource AccentSurface}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="1"
                        CornerRadius="32">
                        <TextBlock
                            x:Name="EmptyStateIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="26"
                            Foreground="{DynamicResource Accent}"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <!-- “正在加载”提示由代码驱动该变换持续旋转，其余状态保持静止。 -->
                                <RotateTransform x:Name="EmptyStateIconRotation" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <TextBlock
                        x:Name="EmptyStateText"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        LineHeight="20"
                        Foreground="{DynamicResource TextSecondary}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </Grid>

        <Grid
            x:Name="PaginationBar"
            Grid.Row="2"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PreviousPageButton"
                Height="38"
                MinWidth="92"
                Content="上一页"
                Click="PreviousPage_Click" />
            <TextBlock
                x:Name="PaginationText"
                Grid.Column="1"
                Margin="14,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextMuted}" />
            <Button
                x:Name="NextPageButton"
                Grid.Column="2"
                Height="38"
                MinWidth="92"
                Content="下一页"
                Click="NextPage_Click" />
        </Grid>

        <!-- 页面内即时提示：复用阅读页的通知控件，用于搜索等操作的反馈。 -->
        <controls:InlineNotification x:Name="PageNotification" Grid.Row="1" />
    </Grid>
</UserControl>
