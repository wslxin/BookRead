<UserControl
    x:Class="BookRead.Pages.OpdsBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SourceComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="SourceComboBox"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SourceComboBoxItem}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                                x:Name="ComboBoxRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                            <ToggleButton
                                x:Name="PART_ToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <!-- 覆盖系统默认 ToggleButton 模板，避免浅蓝色悬停高亮破坏深色主题。 -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="12,0,34,0"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsHitTestVisible="False" />
                            <TextBlock
                                Margin="0,0,13,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{DynamicResource TextMuted}"
                                Text="&#xE70D;"
                                IsHitTestVisible="False" />
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,6,0,0"
                                    Background="{DynamicResource DialogBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="18"
                                            Direction="270"
                                            Opacity="0.35"
                                            ShadowDepth="5"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="3" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxRoot" Property="Background" Value="{DynamicResource ButtonHover}" />
                                <Setter TargetName="ComboBoxRoot" Property="BorderBrush" Value="{DynamicResource Line}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBoxRoot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBoxRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="SourceComboBox"
                Height="38"
                Style="{StaticResource SourceComboBox}"
                SelectionChanged="SourceComboBox_SelectionChanged" />
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    Height="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    KeyDown="SearchTextBox_KeyDown"
                    IsEnabled="False" />
                <Button
                    Grid.Column="1"
                    Height="38"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Content="搜索"
                    IsEnabled="False"
                    Click="Search_Click" />
            </Grid>
            <Button
                x:Name="SearchBackButton"
                Grid.Column="2"
                Height="38"
                Padding="12,0"
                Margin="10,0,0,0"
                Content="退出搜索"
                Visibility="Collapsed"
                Click="SearchBack_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock
                    x:Name="StatusText"
                    Margin="4,20,4,20"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextMuted}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ListBox
                    x:Name="EntryList"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- 清除全局列表项模板的隐藏内边距，避免浏览页卡片每行少排一项并造成右侧空白。 -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="170"
                                Margin="6,14"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="{DynamicResource SurfaceBackground}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                Click="EntryButton_Click"
                                Tag="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Header="取消下载"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="CancelDownload_Click"
                                            Tag="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Margin="10,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid
                                        Grid.Row="0"
                                        Width="88"
                                        Height="124"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Border Background="{DynamicResource Line}" CornerRadius="6" />
                                        <Image Tag="CoverImage" Stretch="Uniform" />
                                        <ProgressBar
                                            Height="4"
                                            Margin="8,0"
                                            VerticalAlignment="Bottom"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding DownloadProgress, Mode=OneWay}"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="&#xE8B6;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="32"
                                            Foreground="{DynamicResource TextMuted}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Text="{Binding Entry.Title}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        MaxHeight="36"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        Text="{Binding Subtitle}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMuted}"
                                        Visibility="{Binding ShowAuthor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Entry.Summary}" />
                                    <ProgressBar
                                        x:Name="DownloadProgressBar"
                                        Grid.Row="3"
                                        Height="3"
                                        Margin="0,8,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding DownloadProgress, Mode=OneWay}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <Button
            x:Name="LoadMoreButton"
            Grid.Row="2"
            Height="38"
            Margin="0,12,0,0"
            Content="加载更多"
            Visibility="Collapsed"
            Click="LoadMore_Click" />
    </Grid>
</UserControl>
