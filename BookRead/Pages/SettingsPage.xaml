<UserControl
    x:Class="BookRead.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BookRead.Controls"
    Background="{DynamicResource AppBackground}">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsNavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <!-- 与书架“添加书籍”菜单一致：悬浮亮起并轻微放大，移出后平滑恢复。 -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1.04"
                                    Duration="0:0:0.16" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1.04"
                                    Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1"
                                    Duration="0:0:0.18" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1"
                                    Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddSourceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        ShadowDepth="2"
                                        Direction="270"
                                        Opacity="0.35"
                                        Color="#000000" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="164" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="设置" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <Button x:Name="ShortcutTabButton" Tag="Shortcuts" Style="{StaticResource SettingsNavigationButton}" Click="SettingsTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="快捷键" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DisplayTabButton" Tag="Display" Style="{StaticResource SettingsNavigationButton}" Click="SettingsTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="显示" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpdsTabButton" Tag="Opds" Style="{StaticResource SettingsNavigationButton}" Click="SettingsTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="OPDS 书源" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid>
                    <StackPanel x:Name="ShortcutSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="全局快捷键" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="在所有页面中生效" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="切换主题" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="ToggleThemeTextBox" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="ToggleTheme" />
                        </Grid>

                        <TextBlock Text="阅读快捷键" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <TextBlock Text="仅在阅读页面中生效" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="下一页" Grid.Row="0" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="NextPageTextBox" Grid.Row="0" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="NextPage" />
                            <TextBlock Text="上一页" Grid.Row="1" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="PreviousPageTextBox" Grid.Row="1" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="PreviousPage" />
                            <TextBlock Text="下一章" Grid.Row="2" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="NextChapterTextBox" Grid.Row="2" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="NextChapter" />
                            <TextBlock Text="上一章" Grid.Row="3" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="PreviousChapterTextBox" Grid.Row="3" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="PreviousChapter" />
                            <TextBlock Text="向下滚动" Grid.Row="4" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="ScrollDownTextBox" Grid.Row="4" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="ScrollDown" />
                            <TextBlock Text="向上滚动" Grid.Row="5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="ScrollUpTextBox" Grid.Row="5" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="ScrollUp" />
                            <TextBlock Text="增大字号" Grid.Row="6" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="IncreaseFontTextBox" Grid.Row="6" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="IncreaseFont" />
                            <TextBlock Text="减小字号" Grid.Row="7" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="DecreaseFontTextBox" Grid.Row="7" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="DecreaseFont" />
                            <TextBlock Text="增大行间距" Grid.Row="8" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="IncreaseLineSpacingTextBox" Grid.Row="8" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="IncreaseLineSpacing" />
                            <TextBlock Text="减小行间距" Grid.Row="9" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="DecreaseLineSpacingTextBox" Grid.Row="9" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="DecreaseLineSpacing" />
                            <TextBlock Text="透明背景" Grid.Row="10" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="ToggleTransparencyTextBox" Grid.Row="10" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="ToggleTransparency" />
                            <TextBlock Text="章节面板" Grid.Row="11" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox x:Name="ToggleChapterTextBox" Grid.Row="11" Grid.Column="1" Height="38" Margin="0,0,0,10" Padding="9,0" IsReadOnly="True" PreviewKeyDown="ShortcutTextBox_PreviewKeyDown" Tag="ToggleChapter" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="DisplaySettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="阅读界面" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox x:Name="ShowReaderToolbarCheckBox" Style="{StaticResource SettingsCheckBox}" FontSize="13" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="显示阅读页工具栏" />
                                <TextBlock Text="隐藏后可获得更大的正文阅读区域" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="窗口行为" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,10" />
                        <CheckBox x:Name="MinimizeToTrayOnCloseCheckBox" Style="{StaticResource SettingsCheckBox}" FontSize="13" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="关闭窗口时最小化到系统托盘" />
                                <TextBlock Text="取消勾选后，点击关闭按钮将直接退出 BookRead" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel x:Name="OpdsSettingsPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已添加的 OPDS 书源" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource AddSourceButton}"
                                Click="AddOpdsSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="添加书源" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListBox
                            x:Name="OpdsSourceList"
                            MinHeight="180"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0" Padding="0" Tag="{Binding}" ToolTip="编辑" Click="EditOpdsSource_Click">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource Accent}" />
                                        </Button>
                                        <Button Grid.Column="2" Width="30" Height="30" Margin="6,0,0,0" Padding="0" Tag="{Binding}" ToolTip="删除" Click="DeleteOpdsSource_Click">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#F44336" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Width="78" Height="34" Click="Cancel_Click">取消</Button>
                <Button Width="78" Height="34" Margin="8,0,0,0" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource Accent}" Click="Save_Click">保存</Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
