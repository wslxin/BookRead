<UserControl
    x:Class="BookRead.Controls.InlineNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="0,0,0,18"
    IsHitTestVisible="False">
    <Border
        Padding="12,7"
        Background="{DynamicResource Panel}"
        BorderBrush="{DynamicResource Line}"
        BorderThickness="1"
        CornerRadius="5">
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextPrimary}" />
    </Border>
</UserControl>
