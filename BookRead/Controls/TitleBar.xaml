<UserControl
    x:Class="BookRead.Controls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Border
        Background="{DynamicResource SurfaceBackground}"
        BorderBrush="{DynamicResource Line}"
        BorderThickness="0,0,0,1"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="102" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Height="34"
                    Padding="10,0"
                    Margin="0,0,14,0"
                    Visibility="Collapsed"
                    ToolTip="返回"
                    PreviewMouseRightButtonUp="BackButton_PreviewMouseRightButtonUp"
                    Click="Back_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BackButtonIcon" Text="&#xE76B;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="BackButtonText" Text="返回" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="AppBrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="31" Height="31" Source="/BookRead;component/readbook.ico" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="BOOKREAD" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
                <StackPanel x:Name="BookInfoPanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="640">
                    <TextBlock x:Name="BookTitleText" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <!-- 下载入口常驻标题栏：有任务时显示进度文本，空闲时只保留图标，点击进入下载详情。 -->
                <Button
                    x:Name="DownloadIndicatorButton"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Margin="0,0,2,0"
                    ToolTip="查看下载详情"
                    Click="DownloadIndicator_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="DownloadIndicatorIcon"
                            Text="&#xE896;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ButtonForeground}" />
                        <TextBlock
                            x:Name="DownloadIndicatorText"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <StackPanel
                    x:Name="BrowseActionsPanel"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Button
                        x:Name="RefreshButton"
                        Width="30"
                        Height="30"
                        Margin="2,0"
                        Padding="0"
                        ToolTip="刷新目录"
                        Click="Refresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="2" Width="102" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TopmostButton" Width="30" Height="30" Padding="0" ToolTip="置顶窗口" Click="Topmost_Click">
                    <TextBlock x:Name="TopmostIcon" Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="1" Width="30" Height="30" Padding="0" ToolTip="设置" Click="Settings_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource WindowCloseButton}"
                    ToolTip="关闭窗口"
                    Click="CloseWindow_Click">
                    <TextBlock
                        Text="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
