<UserControl
    x:Class="BookRead.Controls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Border
        Background="{DynamicResource SurfaceBackground}"
        BorderBrush="{DynamicResource Line}"
        BorderThickness="0,0,0,1"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackToShelfButton" Height="34" Padding="10,0" Margin="0,0,14,0" Visibility="Collapsed" ToolTip="返回书架" Click="BackToShelf_Click">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="&#xE76B;  " FontFamily="Segoe Fluent Icons" />
                        <Run Text="书架" />
                    </TextBlock>
                </Button>
                <StackPanel x:Name="AppBrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="31" Height="31" Source="/BookRead;component/readbook.ico" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="BOOKREAD" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
                <StackPanel x:Name="BookInfoPanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="640">
                    <TextBlock x:Name="BookTitleText" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Width="68" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Button Width="30" Height="30" Padding="0" ToolTip="设置" Click="Settings_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource WindowCloseButton}"
                    ToolTip="关闭窗口"
                    Click="CloseWindow_Click">
                    <TextBlock
                        Text="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
