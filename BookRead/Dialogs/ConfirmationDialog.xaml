<Window
    x:Class="BookRead.Dialogs.ConfirmationDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="458"
    Height="274"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Background" Value="#D67F3D" />
            <Setter Property="Foreground" Value="#17191C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F09A57" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Background" Value="#D9363E" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F44336" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        Margin="14"
        Background="{DynamicResource DialogBackground}"
        BorderBrush="{DynamicResource InputBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                ShadowDepth="8"
                Direction="270"
                Opacity="0.42"
                Color="#000000" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="IconBackground"
                    Width="34"
                    Height="34"
                    CornerRadius="6"
                    Background="{DynamicResource DangerSurface}">
                    <TextBlock
                        x:Name="DialogIcon"
                        Text="&#xE7BA;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Foreground="#F44336"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    x:Name="DialogTitle"
                    Grid.Column="1"
                    Margin="12,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="17"
                    FontWeight="SemiBold" />
                <Button
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    ToolTip="关闭"
                    IsCancel="True"
                    Click="Cancel_Click">
                    <TextBlock
                        Text="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="46,22,10,18">
                <TextBlock
                    x:Name="DialogMessage"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="14"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DialogDetail"
                    Margin="0,9,0,0"
                    Foreground="{DynamicResource TextMuted}"
                    FontSize="12"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button
                    x:Name="CancelButton"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="Cancel_Click" />
                <Button
                    x:Name="ConfirmButton"
                    IsDefault="True"
                    Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
