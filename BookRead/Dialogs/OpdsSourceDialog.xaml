<Window
    x:Class="BookRead.Dialogs.OpdsSourceDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BookRead.Controls"
    Width="500"
    Height="565"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="#4C7AA4" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                HorizontalContentAlignment="Left"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#7AB4F8" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5F6C77" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Background" Value="#D67F3D" />
            <Setter Property="Foreground" Value="#17191C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F09A57" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        Margin="14"
        Background="{DynamicResource DialogBackground}"
        BorderBrush="{DynamicResource InputBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                ShadowDepth="8"
                Direction="270"
                Opacity="0.42"
                Color="#000000" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="DialogTitle"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimary}"
                FontSize="17"
                FontWeight="SemiBold" />

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="书源名称" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <TextBox x:Name="NameTextBox" Height="38" Margin="0,7,0,0" Padding="10,0" VerticalContentAlignment="Center" />
                <TextBlock Text="OPDS 地址" Margin="0,14,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <TextBox x:Name="UrlTextBox" Height="38" Margin="0,7,0,0" Padding="10,0" VerticalContentAlignment="Center" />
                <TextBlock Text="用户名（可选）" Margin="0,14,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <TextBox x:Name="UsernameTextBox" Height="38" Margin="0,7,0,0" Padding="10,0" VerticalContentAlignment="Center" />
                <TextBlock Text="密码（可选）" Margin="0,14,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,7,0,0" Padding="10,0" VerticalContentAlignment="Center" />
                <CheckBox x:Name="IgnoreCertificateCheckBox" Margin="0,10,0,0" Style="{StaticResource SettingsCheckBox}" FontSize="13" Content="忽略 HTTPS 证书错误（自建服务器使用）" />

            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:InlineNotification
                    x:Name="StatusNotification"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,12" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button
                        x:Name="TestButton"
                        Style="{StaticResource DialogSecondaryButton}"
                        Content="测试连接"
                        Click="Test_Click" />
                    <Button
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"
                        Content="取消"
                        Click="Cancel_Click" />
                    <Button
                        IsDefault="True"
                        Margin="8,0,0,0"
                        Style="{StaticResource DialogPrimaryButton}"
                        Content="保存"
                        Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
