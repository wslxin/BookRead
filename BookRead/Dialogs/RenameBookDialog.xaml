<Window
    x:Class="BookRead.Dialogs.RenameBookDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="438"
    Height="268"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Loaded="RenameBookDialog_Loaded">
    <Window.Resources>
        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Background" Value="#D67F3D" />
            <Setter Property="Foreground" Value="#17191C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F09A57" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        Margin="14"
        Background="{DynamicResource DialogBackground}"
        BorderBrush="{DynamicResource InputBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                ShadowDepth="8"
                Direction="270"
                Opacity="0.42"
                Color="#000000" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="34"
                    Height="34"
                    CornerRadius="6"
                    Background="{DynamicResource Line}">
                    <TextBlock
                        Text="&#xE70F;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Foreground="{DynamicResource Accent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="重命名书籍" />
                <Button
                    Grid.Column="2"
                    Style="{StaticResource WindowCloseButton}"
                    ToolTip="关闭"
                    IsCancel="True"
                    Click="Cancel_Click">
                    <TextBlock
                        Text="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="46,20,10,18">
                <TextBlock
                    Foreground="{DynamicResource TextMuted}"
                    FontSize="12"
                    Text="书籍名称" />
                <TextBox
                    x:Name="BookTitleTextBox"
                    Height="38"
                    Margin="0,7,0,0"
                    Padding="10,0"
                    VerticalContentAlignment="Center" />
                <TextBlock
                    x:Name="ValidationMessage"
                    Margin="0,7,0,0"
                    Foreground="#F44336"
                    FontSize="12"
                    Text="书籍名称不能为空。"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource DialogSecondaryButton}"
                    Content="取消"
                    Click="Cancel_Click" />
                <Button
                    IsDefault="True"
                    Style="{StaticResource DialogPrimaryButton}"
                    Content="保存"
                    Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
